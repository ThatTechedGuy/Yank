# Files git should never track. Same syntax as in any JS/Android project.

# Generated by XcodeGen from project.yml; run `xcodegen` to recreate it (see project.yml).
/Yank.xcodeproj/

# Build output. ≈ node_modules/.cache, .next/ or Android's build/ folders.
#   DerivedData/  Xcode's build folder when it's kept inside the project
#   build/        our build folder (scripts pass -derivedDataPath build)
#   build-*/      the same for a git worktree (-derivedDataPath build-stage-4, say)
#   .build/       SwiftPM's build folder from `swift build` / `swift test`
#   .swiftpm/     SwiftPM's local Xcode settings
DerivedData/
build/
build-*/
.build/
.swiftpm/
# Per-user Xcode state: window layout, breakpoints, last-opened files.
xcuserdata/
*.xcuserstate

# Finder's per-folder view settings.
.DS_Store
